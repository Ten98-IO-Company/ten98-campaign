{
  "name": "ten98-campaign",
  "version": "0.7.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "openid-client": "6.8.8",
    "qrcode-generator": "2.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "license": "MIT",
  "description": "Open-source campaign management for per-platform social publishing, advertising, OOH media and digital assets",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ten98-IO-Company/ten98-campaign.git"
  }
}
