# Production / local preview. Development always uses DEV_APP_URL below.
APP_URL=http://127.0.0.1:3018
HOST=127.0.0.1
PORT=3018
DATA_DIR=./data
DEV_APP_URL=http://127.0.0.1:5178

# Optional: at least 32 random characters. Otherwise generated in DATA_DIR.
SESSION_SECRET=

# Configure keys on the server, then map each project in Settings.
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=
# Register APP_URL/api/webhooks/zernio in Zernio; it must be publicly reachable.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the PEM private key in quotes, with literal \n for line breaks.
GOOGLE_PRIVATE_KEY=

# OpenRouter models execute remotely; the agent and tools run in this app.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_MAX_TOKENS=2048
OPENROUTER_MAX_STEPS=4

# Google Maps JavaScript API key: browser-visible by design.
# Restrict it to Maps JavaScript API and the allowed app HTTP referrers.
GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_MAPS_MAP_ID=

# Broadsign Guaranteed Campaigns / Direct. Default to its sandbox.
BROADSIGN_API_KEY=
BROADSIGN_ENVIRONMENT=sandbox
# Optional: require this domain in the verified provider account.
BROADSIGN_DOMAIN_ID=

# Optional organizational single sign-on (HTTPS issuer).
# Register APP_URL/api/auth/oidc/callback as the redirect URI.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Comma-separated verified emails allowed to create separate OIDC accounts.
# Existing local accounts are never automatically linked by email.
OIDC_ALLOWED_EMAILS=
